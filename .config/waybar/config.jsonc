{
    "layer": "top",
    "modules-center": ["hyprland/workspaces"],
    "modules-left": ["hyprland/window"],
    "modules-right": ["group/system-tray", "group/system-buttons"],

    "custom/power-button": {
        "on-click": "bash \"$HOME/.config/fuzzel/power-menu/power-menu.sh\"",
        "format": "{icon}",
        "format-icons": {
            "default": ""
        }
    },

    "group/system-buttons": {
        "orientation": "horizontal",
        "modules": [
            "clock",
            "custom/power-button"
        ]
    },

    "group/system-tray": {
        "orientation": "horizontal",
        "modules": [
            "tray"
        ]
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "persistent-workspaces": {
          "1": [
          ],

          "2": [
          ],

          "3": [
          ],

          "4": [
          ],

          "5": [
          ],

          "6": [
          ],

          "7": [
          ],

          "8": [

          ],

          "9": [

          ]
        }
    },

    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}"
    }
}
